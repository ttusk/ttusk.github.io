---
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
    href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="mx-auto w-full max-w-3xl px-4 py-4 sm:px-6">
    <nav class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <a href="/" title="Home" class:list={{ "nav-link--active": isActive("/") }}>talkinghead</a>
        <span aria-hidden="true">/</span>
        <a href="/posts/" title="Posts" class:list={{ "nav-link--active": isActive("/posts/") }}>posts</a>
        <span aria-hidden="true">/</span>
        <a href="/updates/" title="Updates" class:list={{ "nav-link--active": isActive("/updates/") }}>updates</a>
        <span aria-hidden="true">/</span>
        <a href="/quotes/" title="Quotes" class:list={{ "nav-link--active": isActive("/quotes/") }}>quotes</a>
        <span aria-hidden="true">/</span>
        <a href="/gallery/" title="Gallery" class:list={{ "nav-link--active": isActive("/gallery/") }}>gallery</a>
        <span aria-hidden="true">/</span>
        <a href="/portfolio/" title="Portfolio" class:list={{ "nav-link--active": isActive("/portfolio/") }}>portfolio</a>
        <span aria-hidden="true">/</span>
        <a href="/rss.xml" title="RSS">rss</a>
    </nav>
</header>
