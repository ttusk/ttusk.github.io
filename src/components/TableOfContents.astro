---
import type { MarkdownHeading } from "astro";

interface Props {
    headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const items = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{items.length > 0 && (
    <nav class="post-toc" aria-label="índice do post">
        <p>tópicos:</p>

        <ul>
            {items.map(({ depth, slug, text }) => (
                <li class:list={["post-toc-item", { "post-toc-item--nested": depth === 3 }]}>
                    <a href={`#${slug}`}>{text}</a>
                </li>
            ))}
        </ul>
    </nav>
)}

<style>
    .post-toc {
        font-size: 0.875rem;
        margin-block-end: 2rem;
    }

    .post-toc p {
        color: var(--solarized-base01);
    }

    .post-toc ul {
        list-style: disc;
        margin-block-start: 0.35rem;
        padding-inline-start: 1.5rem;
    }

    .post-toc-item--nested {
        margin-inline-start: 1.25rem;
    }

    .post-toc-item a:focus-visible {
        outline: 2px solid var(--solarized-blue);
        outline-offset: 0.2rem;
    }
</style>
